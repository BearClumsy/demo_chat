# Pinned versions for the cluster add-ons installed by install.sh.
# Bump deliberately; every value is referenced there.

# CNI — Calico in VXLAN mode (no BGP; only UDP 4789 between nodes).
CALICO_VERSION=v3.28.2

# Horizontal Pod Autoscaler metrics source.
METRICS_SERVER_VERSION=v0.7.2

# NGINX Ingress Controller — bare-metal manifest (Service is NodePort; the ALB fronts it).
INGRESS_NGINX_VERSION=controller-v1.11.3

# Graceful node drain on ASG scale-in / rebalance / spot interruption.
NODE_TERMINATION_HANDLER_VERSION=1.22.0

# Optional: scales the worker ASG when pods don't fit. Must match the cluster minor version.
CLUSTER_AUTOSCALER_VERSION=v1.31.1

# Pinned NodePorts the ingress-nginx Service must expose (kept in sync with
# modules/alb-k8s: ingress_http_node_port / ingress_healthz_node_port). The ALB only forwards to
# HTTP (30080) and health-checks 30254; HTTPS is pinned for completeness/direct testing.
INGRESS_HTTP_NODEPORT=30080
INGRESS_HTTPS_NODEPORT=30443
INGRESS_HEALTHZ_NODEPORT=30254
